Thumbs.db

# ---- 模型权重（体积大，用 retrieval/fetch_model.py 重下）----
models/

# ---- 数据库 ----
docker/.env
*.sqlite
*.db

# ---- M17：替身图片（体积大 + 有版权，用 fetch_stand_images.py 重抓）----
# ★★ 必须用 /images/ 根锚定，不能写 images/ ★★
#   gitignore 的 `images/`（无前导斜杠）会匹配**任意层级**的 images 目录
#   → 会把dataset/sources/images/fetch_stand_images.py 一起忽略掉（实测已中招）。
/images/
/.tmp_preview/

# ---- M21：维基抓取的本地缓存（可从维基重新生成，约 650 KB）----
dataset/sources/zh_names/_cache_*

# ---- M23：第三方版权内容（不入公开仓库）----
# ★ 这两个文件是抓取来的**第三方原文**，版权属荒木飞吕彦 / 集英社：
#   - text_chunks.json     jojowiki 的替身描述原文（2407 块，1.7 MB）
#   - stand_stats_main.html 维基页面 HTML 快照（0.4 MB）
#   公开仓库放原文有版权风险 → 排除。
#   结构化数据（stands.json / stand_stats.json / details.json）保留，
#   它们是**字段值**而非成段文字。
#   ★ 别人 clone 后按 README「重建原文语料」一节跑抓取即可重建。
dataset/processed/text_chunks.json
dataset/sources/stand_stats_main.html

# ---- filter-branch 的临时产物（不要提交）----
.git-rewrite/
