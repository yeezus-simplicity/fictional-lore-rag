# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- 原始抓取（体积大，可重跑）----
dataset/sources/rendered/
docs/字段映射/*.html

# ---- 索引与模型（体积大）----
index/
models/
*.gguf
*.safetensors
*.faiss
*.npy
data/

